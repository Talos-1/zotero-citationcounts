{
	"manifest_version": 2,
	"name": "Zotero Citation Counts Manager",
	"version": "2.0.0",
	"description": "Automatically fetch and update citation counts from Crossref, INSPIRE-HEP, Semantic Scholar and NASA/ADS.",
	"author": "Erik Schnetter",
	"homepage_url": "https://github.com/Talos-1/zotero-citationcounts",
	"icons": {
		"48": "icons/citationcounts.png",
		"96": "icons/citationcounts@2x.png"
	},
	"applications": {
		"zotero": {
			"id": "schnetter@gmail.com",
			"update_url": "https://raw.githubusercontent.com/Talos-1/zotero-citationcounts/master/updates.json",
			"strict_min_version": "8.0",
			"strict_max_version": "10.0.*"
		}
	}
}
